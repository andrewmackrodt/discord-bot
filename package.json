{
  "name": "discord-bot",
  "version": "0.0.0",
  "description": "Node.js Discord Bot",
  "license": "UNLICENSED",
  "author": {
    "name": "Andrew Mackrodt",
    "email": "andrewmackrodt@gmail.com",
    "url": "https://gitlab.com/andrewmackrodt/discord-bot"
  },
  "main": "index.js",
  "scripts": {
    "build": "run-s clean build:compile",
    "build:check": "tsc --noEmit",
    "build:compile": "ts-node build",
    "check": "run-p build:check format:check lint:check license:check vulnerability:check",
    "clean": "shx rm -rf \"./out/\"",
    "coverage": "jest --collect-coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "license:check": "license-checker --excludePackages \"$(echo $(npm pkg get name)@$(npm pkg get version) | sed 's/\\\"//g')\" --production --unknown --onlyAllow='Apache-2.0;BSD;CC0-1.0;ISC;MIT;MPL-2.0'",
    "lint": "eslint --fix",
    "lint:check": "eslint",
    "lint:pr": "eslint --format rdjson . | reviewdog -f=rdjson -reporter=github-pr-review",
    "lint:push": "eslint --format rdjson . | reviewdog -f=rdjson -reporter=github-check",
    "start": "ts-node index.ts",
    "test": "jest",
    "typeorm": "ts-node ./node_modules/typeorm/cli -d src/db",
    "vulnerability:check": "pnpm audit --audit-level critical --ignore-registry-errors  --ignore-unfixable --prod",
    "watch": "ts-node-dev --respawn --transpile-only index"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "better-sqlite3": "^12.6.2",
    "bufferutil": "^4.1.0",
    "cheerio": "^1.2.0",
    "discord.js": "^14.25.1",
    "dotenv": "^17.3.1",
    "gm": "^1.25.1",
    "node-schedule": "^2.1.1",
    "openai": "^6.27.0",
    "reflect-metadata": "^0.2.2",
    "spotify-web-api-node": "^5.0.2",
    "tslib": "^2.8.1",
    "tsyringe": "^4.10.0",
    "typeorm": "^0.3.28",
    "utf-8-validate": "^6.0.6"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.2",
    "@eslint/js": "^9.39.3",
    "@jest/types": "^30.2.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/core": "^1.15.18",
    "@swc/helpers": "^0.5.19",
    "@swc/jest": "^0.2.39",
    "@types/better-sqlite3": "^7.6.13",
    "@types/fs-extra": "^11.0.4",
    "@types/gm": "^1.25.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.15",
    "@types/node-schedule": "^2.1.8",
    "@types/shelljs": "^0.10.0",
    "@types/spotify-web-api-node": "^5.0.11",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-formatter-rdjson": "^1.0.6",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-perfectionist": "^5.6.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fs-extra": "^11.3.4",
    "globals": "^17.4.0",
    "jest": "^30.2.0",
    "license-checker": "^25.0.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.8.1",
    "prettier-plugin-jsdoc": "^1.8.0",
    "prettier-plugin-multiline-arrays": "^4.1.4",
    "prettier-plugin-packagejson": "^3.0.2",
    "shx": "^0.4.0",
    "strong-mock": "^9.2.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017",
  "engines": {
    "node": ">=22"
  }
}
